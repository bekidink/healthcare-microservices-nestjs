# Copy to .env for local (non-docker) development. Inside docker-compose,
# these are set directly as environment: entries in docker-compose.yml.
#
# Each service only ever needs its own DATABASE_URL (its own database) and
# a distinct KAFKA_CLIENT_ID — never another service's DATABASE_URL.

# --- Gateway ---
PORT=3000
IDENTITY_SERVICE_URL=http://localhost:3001
FACILITY_SERVICE_URL=http://localhost:3002
PATIENT_SERVICE_URL=http://localhost:3003
SCHEDULING_SERVICE_URL=http://localhost:3004
CLINICAL_SERVICE_URL=http://localhost:3005
LAB_SERVICE_URL=http://localhost:3006
PHARMACY_SERVICE_URL=http://localhost:3007
FINANCE_SERVICE_URL=http://localhost:3008
COMMUNICATION_SERVICE_URL=http://localhost:3009
INPATIENT_SERVICE_URL=http://localhost:3010
SUPPLY_SERVICE_URL=http://localhost:3011
INTEROP_SERVICE_URL=http://localhost:3012
ANALYTICS_SERVICE_URL=http://localhost:3013
JWT_ACCESS_SECRET=dev-access-secret-change-me
CORS_ORIGINS=*

# --- Identity ---
DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/identity_db?schema=public
REDIS_URL=redis://localhost:6379
KAFKA_CLIENT_ID=identity-service
NODE_ENV=development

# --- Facility (PORT=3002, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/facility_db?schema=public
# KAFKA_CLIENT_ID=facility-service

# --- Patient (PORT=3003, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/patient_db?schema=public
# KAFKA_CLIENT_ID=patient-service

# --- Scheduling (PORT=3004, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/scheduling_db?schema=public
# KAFKA_CLIENT_ID=scheduling-service
# FACILITY_SERVICE_URL=http://localhost:3002

# --- Clinical (PORT=3005, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/clinical_db?schema=public
# KAFKA_CLIENT_ID=clinical-service
# SCHEDULING_SERVICE_URL=http://localhost:3004

# --- Lab (PORT=3006, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/lab_db?schema=public
# KAFKA_CLIENT_ID=lab-service
# CLINICAL_SERVICE_URL=http://localhost:3005

# --- Pharmacy (PORT=3007, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/pharmacy_db?schema=public
# KAFKA_CLIENT_ID=pharmacy-service
# CLINICAL_SERVICE_URL=http://localhost:3005

# --- Finance (PORT=3008, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/finance_db?schema=public
# KAFKA_CLIENT_ID=finance-service
# CLINICAL_SERVICE_URL=http://localhost:3005

# --- Communication (PORT=3009, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/communication_db?schema=public
# KAFKA_CLIENT_ID=communication-service
# SCHEDULING_SERVICE_URL=http://localhost:3004

# --- Inpatient (PORT=3010, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/inpatient_db?schema=public
# KAFKA_CLIENT_ID=inpatient-service
# CLINICAL_SERVICE_URL=http://localhost:3005

# --- Supply (PORT=3011, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/supply_db?schema=public
# KAFKA_CLIENT_ID=supply-service

# --- Interop (PORT=3012, its own DATABASE_URL — no Kafka, read-only service) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/interoperability_db?schema=public
# PATIENT_SERVICE_URL=http://localhost:3003
# CLINICAL_SERVICE_URL=http://localhost:3005

# --- Analytics (PORT=3013, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/analytics_db?schema=public
# KAFKA_CLIENT_ID=analytics-service
# PHARMACY_SERVICE_URL=http://localhost:3007
# PATIENT_SERVICE_URL=http://localhost:3003
# CLINICAL_SERVICE_URL=http://localhost:3005

# :9094 is the host-reachable listener (PLAINTEXT_HOST) — services running
# *inside* docker-compose use kafka:9092 instead (see docker-compose.yml).
KAFKA_BROKERS=localhost:9094
