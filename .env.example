# Copy to .env for local (non-docker) development. Inside docker-compose,
# these are set directly as environment: entries in docker-compose.yml.
#
# Each service only ever needs its own DATABASE_URL (its own database) and
# a distinct KAFKA_CLIENT_ID — never another service's DATABASE_URL.

# --- Gateway ---
PORT=3000
IDENTITY_SERVICE_URL=http://localhost:3001
FACILITY_SERVICE_URL=http://localhost:3002
PATIENT_SERVICE_URL=http://localhost:3003
JWT_ACCESS_SECRET=dev-access-secret-change-me
CORS_ORIGINS=*

# --- Identity ---
DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/identity_db?schema=public
REDIS_URL=redis://localhost:6379
KAFKA_CLIENT_ID=identity-service
NODE_ENV=development

# --- Facility (PORT=3002, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/facility_db?schema=public
# KAFKA_CLIENT_ID=facility-service

# --- Patient (PORT=3003, its own DATABASE_URL/KAFKA_CLIENT_ID) ---
# DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/patient_db?schema=public
# KAFKA_CLIENT_ID=patient-service

# :9094 is the host-reachable listener (PLAINTEXT_HOST) — services running
# *inside* docker-compose use kafka:9092 instead (see docker-compose.yml).
KAFKA_BROKERS=localhost:9094
